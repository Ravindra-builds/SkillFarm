

# Neon Postgres — https://neon.tech
DATABASE_URL="postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require"

# Auth.js — generate with `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET="replace-with-32-char-random-string"


AUTH_GOOGLE_ID="your-google-oauth-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-oauth-client-secret"
# Aliases also accepted for compatibility
# GOOGLE_CLIENT_ID="..."
# GOOGLE_CLIENT_SECRET="..."


# 2. Google Gemini
GEMINI_API_KEY=AIzaSy...
# Optional Gemini model override:
 GEMINI_MODEL=gemini-2.5-flash

# 3. OpenAI
OPENAI_API_KEY="sk..."
# Optional OpenAI model override:
 OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# 4. Optional Role Overrides (cross-provider)
# ROUTER_MODEL=
# SYNTHESIZER_MODEL=

# ── Research
# Start with one; add others incrementally
TAVILY_API_KEY="tvly-..."
# EXA_API_KEY="..."
GITHUB_TOKEN="github_pat_..."   # for higher rate limits
YOUTUBE_API_KEY="AIza..."       # from Google Cloud → YouTube Data API v3

# ── Cache
# Upstash Redis — https://upstash.com
UPSTASH_REDIS_REST_URL="https://...upstash.io"
UPSTASH_REDIS_REST_TOKEN="..."

#ROADMAP GENERATION
ROADMAP_LLM_PROVIDER="gemini"
ROADMAP_LLM_MODEL="gemini-3.5-flash"

# ── App ──
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ── Mock Mode ──
# Set to "true" to force the app to use in-memory mock data even when
# real API keys are present. Useful for UI development without live services.
#
# ⚠️  Do NOT set this to true in production — all plan limits and rate limiters
#    become ineffective because they rely on in-memory state that resets on
#    each cold start.
#
# Default: "false" (mock mode is only activated automatically when individual
# API keys like OPENAI_API_KEY or DATABASE_URL are missing/placeholder).
ENABLE_MOCK_MODE="false"

# ── Optional ──
# NEXTAUTH_URL is deprecated in Auth.js v5; use NEXT_PUBLIC_APP_URL + trustHost instead.

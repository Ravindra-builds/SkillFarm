# ==============================================================================
# 🌾 SKILLFARM — ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy this file to .env.local and populate your secrets before running the app.
# Read SETUP.md for step-by-step instructions on acquiring each key.
# ==============================================================================

# ── 1. Database (Neon Serverless PostgreSQL) ──────────────────────────────────
# Required for production persistence. Sign up at https://neon.tech
DATABASE_URL="postgresql://user:password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require"

# ── 2. Authentication (Auth.js v5 & Google OAuth 2.0) ─────────────────────────
# Generate with `openssl rand -base64 32` or `npx auth secret`
AUTH_SECRET="replace-with-32-char-random-string"

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
AUTH_GOOGLE_ID="your-google-oauth-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-oauth-client-secret"

# Optional Email OTP with Resend (https://resend.com)
RESEND_API_KEY="re_xxxxxxxxx"
EMAIL_FROM="SkillFarm <noreply@skillfarm.in>"

# ── 3. AI & LLM Providers ─────────────────────────────────────────────────────
# Google Gemini (Recommended for roadmaps & speed — https://aistudio.google.com)
GEMINI_API_KEY="AIzaSy..."
GEMINI_MODEL="gemini-2.5-flash"

# OpenAI (https://platform.openai.com)
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o-mini"

# Anthropic Claude (Optional — https://console.anthropic.com)
# ANTHROPIC_API_KEY="sk-ant-..."
# ANTHROPIC_MODEL="claude-3-5-sonnet-latest"

# ── 4. Roadmap Generation Defaults ────────────────────────────────────────────
ROADMAP_LLM_PROVIDER="gemini"
ROADMAP_LLM_MODEL="gemini-2.5-flash"

# ── 5. Cache, Rate Limiting & Guest Sandbox (Upstash Redis) ───────────────────
# Sign up at https://console.upstash.com
UPSTASH_REDIS_REST_URL="https://your-database.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_rest_token"

# ── 6. Cloudflare R2 Object Storage (Resume Storage) ──────────────────────────
# Create bucket and API token at https://dash.cloudflare.com
CLOUDFLARE_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="skillfarm-resumes"
# Optional public CDN domain if enabled on bucket (in-app DB viewer does not require this):
# R2_PUBLIC_URL="https://pub-xxx.r2.dev"

# ── 7. Research & Resource Evaluation Providers ───────────────────────────────
# Tavily Web Search (https://tavily.com)
TAVILY_API_KEY="tvly-..."

# YouTube Data API v3 (Google Cloud Console -> Library -> YouTube Data API v3)
YOUTUBE_API_KEY="AIzaSy..."

# GitHub Personal Access Token (for higher API rate limits when searching repos)
GITHUB_TOKEN="github_pat_..."

# Optional Exa AI (https://exa.ai)
# EXA_API_KEY="..."

# ── 8. Personalized Long-Term Memory (Mem0 AI) ────────────────────────────────
# Optional Mem0 Platform integration (https://mem0.ai)
# MEM0_API_KEY="m0-..."

# ── 9. Application & Deployment ───────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ── 10. Mock Mode (Development Only) ──────────────────────────────────────────
# Set to "false" in production. Mock mode is automatically triggered if essential
# keys are missing in development.
ENABLE_MOCK_MODE="false"
